{
  "name": "offerly",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev -H 127.0.0.1 --port 3001",
    "predev": "node scripts/setup-db.mjs",
    "demo": "node scripts/demo-guard.mjs && mkdir -p local-data && drizzle-kit migrate && tsx --conditions=react-server scripts/db-sync-firms.ts && tsx --conditions=react-server scripts/seed-demo-user.ts && tsx --conditions=react-server scripts/seed-outreach-demo.ts && DATABASE_URL= next dev -H 127.0.0.1 --port 3001",
    "demo:network": "node scripts/demo-guard.mjs && mkdir -p local-data && PGLITE_DATA_DIR=./local-data/pglite-demo drizzle-kit migrate && PGLITE_DATA_DIR=./local-data/pglite-demo tsx scripts/seed-schools.ts && PGLITE_DATA_DIR=./local-data/pglite-demo tsx --conditions=react-server scripts/seed-demo-network.ts && DATABASE_URL= PGLITE_DATA_DIR=./local-data/pglite-demo NEXT_DIST_DIR=.next-demo next dev -H 127.0.0.1 --port 3004",
    "build": "next build",
    "start": "next start",
    "prestart": "node scripts/setup-db.mjs",
    "lint": "eslint",
    "postinstall": "patch-package",
    "help:learn": "node --env-file=.env.local --import tsx --conditions=react-server scripts/help-knowledge-learn.ts",
    "help:eval": "node --env-file=.env.local --import tsx --conditions=react-server scripts/help-assistant-eval.ts",
    "monitor:run": "tsx --env-file=.env.local --conditions=react-server scripts/monitor-run.ts",
    "review:agent": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/review-agent.ts",
    "review:sample": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/review-agent-sample.ts",
    "news:run": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/news-run.ts",
    "news:sources": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/news-sources.ts",
    "news:scout": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/news-scout.ts",
    "news:eval": "tsx --env-file-if-exists=.env.local --conditions=react-server scripts/news-eval/run.ts",
    "test": "node --import tsx --conditions=react-server --test \"scripts/test/*.test.ts\"",
    "test:form-adv-full": "node --import tsx --conditions=react-server --test \"scripts/test/full/*.test.ts\"",
    "test:all": "npm run test && npm run typecheck && tsx scripts/content-limits-test.ts && tsx scripts/content-limits-coverage-test.ts && tsx --conditions=react-server scripts/draft-review-test.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file-if-exists=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "db:sync-firms": "node --env-file-if-exists=.env.local --import tsx --conditions=react-server scripts/db-sync-firms.ts",
    "db:seed-interview-questions": "node --env-file-if-exists=.env.local --import tsx --conditions=react-server scripts/seed-interview-questions.ts",
    "storage:process-deletions": "node --env-file-if-exists=.env.local --import tsx --conditions=react-server scripts/process-object-deletions.ts",
    "eval:video": "node --env-file-if-exists=.env.local --import tsx --conditions=react-server scripts/eval/video-interview-eval.ts",
    "eval:video-import": "node --import tsx --conditions=react-server scripts/eval/import-dataset.ts",
    "history:import": "tsx scripts/import-historical-releases.ts",
    "setup": "node scripts/setup-db.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@electric-sql/pglite": "^0.5.5",
    "@tailwindcss/typography": "^0.5.20",
    "date-fns": "^4.4.0",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.31.0",
    "marked": "^18.0.9",
    "next": "16.3.6",
    "papaparse": "^5.6.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.9",
    "puppeteer": "^25.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "patch-package": "^8.0.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "xlsx": "^0.18.5"
  },
  "description": "A recruiting workspace for students breaking into finance: firm discovery, contact sourcing, outreach drafting, interview prep and a news desk. Self-hosted, single-user, runs on your own API keys.",
  "license": "MIT",
  "author": "Kai Clauson",
  "repository": {
    "type": "git",
    "url": "https://github.com/clausonr-tech/Offerly-Live.git"
  },
  "homepage": "https://github.com/clausonr-tech/Offerly-Live#readme",
  "bugs": {
    "url": "https://github.com/clausonr-tech/Offerly-Live/issues"
  },
  "engines": {
    "node": ">=20.9"
  }
}
