# Leave DATABASE_URL unset for local dev — the app uses an embedded
# Postgres (PGlite) stored in ./local-data automatically.
# Set it to a real Postgres/Supabase connection string in production:
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Anthropic API key, used for email autodraft + strategy prompts.
ANTHROPIC_API_KEY=
# Help assistant: most it may spend per day across all students, in USD.
# Defaults to 10. Set 0 to switch the assistant off.
HELP_ASSISTANT_DAILY_BUDGET_USD=10

# Email delivery, used for school-verification codes.
#
# Leave both of these unset in local dev: the app falls back to a "console"
# transport that prints the verification code to the dev-server terminal, so
# the flow is testable with no provider account and no spend.
#
# For production set a real provider. Resend's free tier (3,000/month) covers
# this comfortably; Brevo (300/day) and MailerSend are equivalents if you'd
# rather not sign up for Resend. All of them require verifying a sending
# domain via DNS before they will deliver to anyone but your own address.
#   RESEND_API_KEY=re_...
#   RESEND_FROM_EMAIL=verify@yourdomain.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Force a specific transport regardless of the above: "console" or "resend".
# Normally leave unset - the app infers it. "console" is refused in production.
EMAIL_TRANSPORT=

# --- Optional integrations (scaffolded, inactive until set) ---

# Google OAuth — powers Google Calendar only (showing the student's real
# calendar on /schedule, and writing interviews / coffee chats / deadlines
# back to a dedicated "Offerly" calendar with Google Meet links). Offerly does
# not connect to Gmail.
#
# Until CLIENT_ID and CLIENT_SECRET are set, the integration stays dark and
# /schedule says so instead of offering a button that dead-ends.
#
# Setup, once, at https://console.cloud.google.com:
#   1. Create (or pick) a project.
#   2. APIs & Services > Library: enable "Google Calendar API".
#   3. APIs & Services > OAuth consent screen: External. While it is in
#      "Testing" only accounts listed under Audience > Test users can connect,
#      so add the test account there. Publishing to production with these
#      scopes requires Google verification.
#   4. Add these scopes on the consent screen:
#        .../auth/calendar.readonly
#        .../auth/calendar.app.created
#        .../auth/calendar.events
#        .../auth/userinfo.email
#   5. Credentials > Create credentials > OAuth client ID, type
#      "Web application". Under "Authorized redirect URIs" add exactly the
#      value of GOOGLE_REDIRECT_URI below - it has to match character for
#      character, port included.
#   6. Paste the client ID and secret here, then restart the dev server.
#
# Note on calendar.app.created: it grants rights only over the calendar
# Offerly itself creates, which is why Offerly's events never land in the
# student's primary calendar.
#
# PORT 3001, NOT 3000. URecruit - the project Offerly was rebranded from - is a
# separate app on this machine and owns 3000. Pinned in package.json's dev
# script, which beats any launcher config.
#
# Google compares this character for character against the Authorised redirect
# URIs on the OAuth client. If they disagree, every connection attempt fails
# with redirect_uri_mismatch - which it did, silently, for weeks.
#
# This value is compared character for character by Google. It has to match
# .claude/launch.json AND the Authorised redirect URI registered on the OAuth
# client, or every connection attempt fails with redirect_uri_mismatch - which
# it did, silently, for weeks.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Twilio — used for the SMS test-send feature. Create an account at
# https://console.twilio.com and buy/verify a from-number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Shared secret for the deadline reminder emails (POST /api/reminders/send).
# Point a cron at that route once a day:
#   curl -X POST -H "Authorization: Bearer $REMINDER_TRIGGER_SECRET" \
#        https://yourdomain.com/api/reminders/send
# The route refuses to run when this is unset - an open endpoint here would let
# anyone send mail from your verified sending domain. Emails go out 7 days
# ahead of an event and are sent once each, guarded by events.reminder_email_sent_at.
REMINDER_TRIGGER_SECRET=

# Local embedded-Postgres data directory. Leave unset for the default
# (./local-data/pglite). Point it at a new path to start from a clean database
# without deleting the old one - see pgliteDataDir() in src/db/client.ts.
PGLITE_DATA_DIR=

# Encrypts the archive of sent emails. Generate with: openssl rand -base64 32
# Use a different key per environment and keep it out of the database host.
EMAIL_ARCHIVE_KEY=

# Encrypts Google OAuth tokens at rest, independent of every other secret.
# Generate with: openssl rand -base64 32. Preferred over EMAIL_ARCHIVE_KEY for
# tokens (lib/token-crypto). In production a token is never stored unencrypted:
# set this (or EMAIL_ARCHIVE_KEY) or connecting Google fails. Rotate by setting
# a new value and running scripts/reseal-oauth-tokens.ts.
OAUTH_TOKEN_KEY=

# Signs practice-question seals (lib/practice-seal). Generate with:
# openssl rand -base64 32. Falls back to EMAIL_ARCHIVE_KEY, then to an ephemeral
# per-process key. Never derived from ANTHROPIC_API_KEY.
PRACTICE_SEAL_KEY=

# People-data provider for contact sourcing
CRUSTDATA_API_KEY=
# Private affinity searches (clubs, interests, coverage, hometown sent as search
# terms). Off unless "on". Do NOT enable in production until the published
# privacy policy / POLICY_VERSION cover it and Crustdata's DPA review is done
# (lib/contact-search-provider affinitySearchEnabled).
# CONTACT_AFFINITY_SEARCH=off

# Brandfetch Logo API - /api/crest asks it for firm logos the harvested
# manifest doesn't cover or whose stored URL has died, before falling back to
# Google's favicons. Free client id (no attribution required) at
# https://brandfetch.com/developers. The id is public by design (it ships in
# image URLs); the env var keeps it out of the committed manifest, not secret.
# Unset, the Brandfetch tier is skipped and behavior is as before.
BRANDFETCH_CLIENT_ID=

# Video interview coach (Interview Prep > Video interview) - speech-to-text.
# Any OpenAI-compatible /audio/transcriptions endpoint: OpenAI, Groq, Azure
# OpenAI, or a self-hosted Whisper server. Server-only: never prefix these with
# NEXT_PUBLIC_. Unset, the coach runs but says it can't transcribe or score.
# Setup and costs: docs/VIDEO_INTERVIEW_SETUP.md
TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
# TRANSCRIPTION_MODEL=whisper-1
# TRANSCRIPTION_RESPONSE_FORMAT=verbose_json
# TRANSCRIPTION_TIMEOUT_MS=45000
# TRANSCRIPTION_LANGUAGE=en

# Video interview coach - PRIVATE object storage for training recordings
# (camera video + audio), used ONLY for students who opt in to training.
# Any S3-compatible store: AWS S3, Cloudflare R2, or Supabase Storage's S3
# endpoint. The bucket must be private. These are server-only credentials -
# never NEXT_PUBLIC_, never a Supabase service-role key. Leave any unset and
# no training recording is kept (the page says so).
#   Supabase: https://<project-ref>.supabase.co/storage/v1/s3, region = project region
#   R2:       https://<account-id>.r2.cloudflarestorage.com, region = auto
#   S3:       https://s3.<region>.amazonaws.com
VIDEO_STORAGE_ENDPOINT=
VIDEO_STORAGE_REGION=
VIDEO_STORAGE_BUCKET=
VIDEO_STORAGE_ACCESS_KEY_ID=
VIDEO_STORAGE_SECRET_ACCESS_KEY=
# Path-style URLs (endpoint/bucket/key). Default true; set false for
# virtual-hosted S3 buckets.
# VIDEO_STORAGE_FORCE_PATH_STYLE=true

# FRED (the St. Louis Fed's database of official statistics) - the Markets
# view's dollar index, oil benchmarks, the Fed's rate, and the
# economic readings and release calendar. Free key at
# fred.stlouisfed.org/docs/api/api_key.html. Treasury yields, ECB exchange
# rates need no key, and stock charts come from TradingView's widgets (no
# key). Without it those blocks are left out.
FRED_API_KEY=
